---
import Base from '../layouts/Base.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
const { data: profile } = (await getEntry('pages', 'profile'))!;
---
<Base title="Profile">
  <div class="container page-content">
    <h1 class="page-title"># Profile</h1>
    <div class="profile-intro"><div><Image class="profile-portrait" src={profile.portrait} widths={[600, 1000, 1600]} sizes="(max-width: 760px) 157vw, 60vw" width={1000} height={443} fit="cover" loading="eager" fetchpriority="high" alt={profile.portraitAlt} format="webp" /><div class="hero-name"><h2>森川結太</h2><p>Morikawa Yuta</p></div></div>
      <aside class="profile-history" aria-label="出身と経歴"><div><h3>出身</h3><p>{profile.hometown}</p></div><div><h3>経歴</h3><dl>{profile.history.map(({year,event})=><div><dt>{year}</dt><dd>{event}</dd></div>)}</dl></div></aside>
    </div>
    <p class="profile-greeting editable-text">{profile.introduction}</p>
    <section class="profile-section" id="skills"><h2># Skills</h2><p class="editable-text">{profile.skillsIntroduction}</p><Skills labels /><p class="editable-text">{profile.designIntroduction}</p><Skills design labels /></section>
    <section class="profile-section"><h2># 価値観</h2><div class="values-list">{profile.values.map(value=><div><h3>{value.title}</h3><p>{value.text}</p></div>)}</div></section>
  </div><Contact />
</Base>
