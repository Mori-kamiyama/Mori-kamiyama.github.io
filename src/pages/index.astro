---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Skills from '../components/Skills.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Contact from '../components/Contact.astro';
import portrait from '../assets/portrait.jpeg';
import illustration from '../assets/about-illustration.png';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 8);
const posts = (await getCollection('blog')).filter(p => p.data.date).sort((a,b) => b.data.date!.getTime() - a.data.date!.getTime());
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <Image class="hero-portrait" src={portrait} alt="神山の景色を背景にした森川結太" widths={[600, 1120, 1680]} sizes="(max-width: 760px) 100vw, 74vw" width={1120} height={495} fit="cover" position="center" loading="eager" fetchpriority="high" format="webp" />
      <div class="hero-name"><h1 id="hero-title">森川結太</h1><p>Morikawa Yuta</p></div>
      <p class="hero-tags"># 静岡県育ち <span># 神山まるごと高専生</span> <span># プログラミング</span></p>
    </div>
  </section>
  <section class="section about-section" aria-labelledby="about-title"><div class="container">
    <h2 class="section-title" id="about-title">About me</h2>
    <div class="about-composition">
      <div class="about-policy"><p>私のポリシーは、</p><h3>「やさしい仕組みを<br />　となりの人に」</h3><p>誰も取り残さない、<br />持続可能なシステムをつくることです。</p></div>
      <Image class="about-illustration" src={illustration} alt="家族、身近な人、社会へと広がるやさしい仕組みのイメージ" width={1080} loading="lazy" format="webp" />
      <p class="about-description">誠実に、となりの人が本当に必要としている<br class="desktop-only" />システムをつくって届ける。<br />そのシステムが長くずっと助けられるような<br class="desktop-only" />ビジネスモデルにする。<br />そういう持続可能で成長していく<br class="desktop-only" />仕組みをつくっていきます。</p>
    </div>
    <ArrowLink href="/profile/" label="私について" />
  </div></section>
  <section class="section skills-section" aria-labelledby="skills-title"><div class="container">
    <h2 class="section-title" id="skills-title">Skills</h2><Skills /><ArrowLink href="/profile/#skills" label="スキルと価値観を見る" />
  </div></section>
  <section class="section works-section" aria-labelledby="works-title"><div class="container">
    <div class="section-heading"><h2 class="section-title" id="works-title">Works</h2><p>つくったもの、取り組んだこと。</p></div>
    <div class="works-grid">{works.map(work => <WorkCard work={work} monochrome />)}</div>
    <ArrowLink href="/works/" label="すべての作品を見る" />
  </div></section>
  <section class="section blog-section" aria-labelledby="blog-title"><div class="container">
    <h2 class="section-title" id="blog-title">Blog</h2>
    <ul class="post-list">{posts.map(post => <li><a href={`/blog/${post.id}/`}><time datetime={post.data.date!.toISOString()}>{post.data.date!.toLocaleDateString('ja-JP',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'})}</time><span>{post.data.title}</span><span aria-hidden="true">↗</span></a></li>)}</ul>
    <ArrowLink href="/blog/" label="記事を読む" />
  </div></section>
  <Contact />
</Base>
