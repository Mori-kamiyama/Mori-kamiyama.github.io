---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('blog')).map(post=>({params:{id:post.id},props:{post}})); }
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} article><div class="container detail-page">
  <nav class="breadcrumb" aria-label="パンくず"><a href="/blog/">Blog</a><span aria-hidden="true">&gt;</span><span aria-current="page">{post.data.title}</span></nav>
  <article class="blog-detail">{post.data.date&&<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP',{timeZone:'Asia/Tokyo'})}</time>}<h1>{post.data.title}</h1><div class="prose"><Content /></div><a class="text-link" href="/blog/">記事一覧に戻る</a></article>
</div></Base>
